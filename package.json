{
  "name": "smartspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SmartSpace & NexusSpace Co-Working Space Management Monorepo",
  "scripts": {
    "dev:api": "pnpm --filter @smartspace/api dev",
    "dev:web": "pnpm --filter @smartspace/web dev",
    "build:shared": "pnpm --filter @smartspace/shared build",
    "build:api": "pnpm --filter @smartspace/api build",
    "build:web": "pnpm --filter @smartspace/web build",
    "build": "pnpm build:shared && pnpm build:api && pnpm build:web",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @smartspace/api test",
    "prisma:generate": "pnpm --filter @smartspace/api prisma:generate",
    "prisma:push": "pnpm --filter @smartspace/api prisma:push",
    "prisma:seed": "pnpm --filter @smartspace/api prisma:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  }
}
