{
  "name": "smartspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SmartSpace & NexusSpace Co-Working Space Management Monorepo",
  "scripts": {
    "dev": "pnpm --filter @smartspace/backend --filter @smartspace/frontend --parallel dev",
    "dev:backend": "pnpm --filter @smartspace/backend dev",
    "dev:frontend": "pnpm --filter @smartspace/frontend dev",
    "dev:api": "pnpm --filter @smartspace/backend dev",
    "dev:web": "pnpm --filter @smartspace/frontend dev",
    "build:shared": "pnpm --filter @smartspace/shared build",
    "build:backend": "pnpm --filter @smartspace/backend build",
    "build:frontend": "pnpm --filter @smartspace/frontend build",
    "build:api": "pnpm --filter @smartspace/backend build",
    "build:web": "pnpm --filter @smartspace/frontend build",
    "build": "pnpm build:shared && pnpm build:backend && pnpm build:frontend",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @smartspace/backend test",
    "prisma:generate": "pnpm --filter @smartspace/backend prisma:generate",
    "prisma:push": "pnpm --filter @smartspace/backend prisma:push",
    "prisma:seed": "pnpm --filter @smartspace/backend prisma:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  }
}
