datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  SPACE_OWNER
  ADMIN
}

enum WorkspaceType {
  PRIVATE_CABIN
  SHARED_DESK
  MEETING_ROOM
  DEDICATED_DESK
}

enum WorkspaceStatus {
  DRAFT
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  ARCHIVED
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum InquiryStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum MeetingStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  fullName         String
  role             UserRole        @default(USER)
  isVerified       Boolean         @default(false)
  verificationToken String?
  resetToken       String?
  resetTokenExpiry DateTime?
  avatarUrl        String?
  phone            String?
  refreshTokenHash String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspaces       Workspace[]     @relation("OwnerWorkspaces")
  bookings         Booking[]
  userPreference   UserPreference?
  reviews          Review[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  inquiryThreads   InquiryThread[] @relation("UserInquiries")
  ownerInquiries   InquiryThread[] @relation("OwnerInquiries")
  inquiryMessages  InquiryMessage[]

  @@index([email])
  @@index([role])
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  teamSize           Int      @default(1)
  workStyle          String   @default("COLLABORATIVE") // QUIET_FOCUS, COLLABORATIVE, HYBRID
  budgetMin          Float    @default(0)
  budgetMax          Float    @default(100)
  preferredCity      String   @default("New York")
  optInSimilarTeams  Boolean  @default(false)
  expectations       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id               String             @id @default(uuid())
  ownerId          String
  title            String
  slug             String             @unique
  description      String
  type             WorkspaceType      @default(PRIVATE_CABIN)
  status           WorkspaceStatus    @default(DRAFT)
  areaSqFt         Int
  seatingCapacity  Int
  pricePerHour     Float
  pricePerDay      Float
  pricePerMonth    Float
  address          String
  city             String
  state            String
  postalCode       String
  latitude         Float
  longitude        Float
  operatingHours   Json?
  rules            Json?
  averageRating    Float              @default(0.0)
  reviewCount      Int                @default(0)
  currentOccupancy Int                @default(0)
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  owner            User               @relation("OwnerWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  amenities        WorkspaceAmenity[]
  images           WorkspaceImage[]
  bookings         Booking[]
  occupancyEvents  OccupancyEvent[]
  apiKeys          SpaceApiKey[]
  inquiryThreads   InquiryThread[]
  reviews          Review[]
  meetingRequests  MeetingRequest[]

  @@index([city, status])
  @@index([pricePerHour])
  @@index([seatingCapacity])
  @@index([latitude, longitude])
  @@index([status])
}

model Amenity {
  id         String             @id @default(uuid())
  slug       String             @unique
  name       String
  category   String
  icon       String?
  workspaces WorkspaceAmenity[]

  @@index([slug])
}

model WorkspaceAmenity {
  workspaceId String
  amenityId   String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amenity     Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([workspaceId, amenityId])
}

model WorkspaceImage {
  id           String    @id @default(uuid())
  workspaceId  String
  url          String
  alt          String?
  displayOrder Int       @default(0)
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, displayOrder])
}

model Booking {
  id                 String        @id @default(uuid())
  workspaceId        String
  userId             String
  status             BookingStatus @default(REQUESTED)
  startTime          DateTime
  endTime            DateTime
  attendeeCount      Int           @default(1)
  totalPrice         Float
  hourlyRate         Float
  cancellationReason String?
  idempotencyKey     String?       @unique
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  review             Review?

  @@index([workspaceId, startTime, endTime])
  @@index([userId, status])
  @@index([status, expiresAt])
}

model OccupancyEvent {
  id          String    @id @default(uuid())
  workspaceId String
  direction   String    // CHECK_IN, CHECK_OUT
  delta       Int       @default(1)
  deviceId    String
  timestamp   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, timestamp])
}

model SpaceApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  keyHash     String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model InquiryThread {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  ownerId     String
  subject     String
  status      InquiryStatus    @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation("UserInquiries", fields: [userId], references: [id], onDelete: Cascade)
  owner       User             @relation("OwnerInquiries", fields: [ownerId], references: [id], onDelete: Cascade)
  messages    InquiryMessage[]
  meetings    MeetingRequest[]

  @@index([userId, status])
  @@index([ownerId, status])
  @@index([workspaceId])
}

model InquiryMessage {
  id          String        @id @default(uuid())
  threadId    String
  senderId    String
  messageText String
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  thread      InquiryThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model MeetingRequest {
  id              String        @id @default(uuid())
  threadId        String?
  workspaceId     String
  userId          String
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  status          MeetingStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  thread          InquiryThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scheduledAt])
}

model Review {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  bookingId   String    @unique
  rating      Int
  comment     String
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([workspaceId, rating])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String   // BOOKING, INQUIRY, OCCUPANCY, SYSTEM
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  diff       Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
}

