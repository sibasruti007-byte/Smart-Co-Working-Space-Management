        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "Start Frontend Web (Port 3000)",
      "type": "shell",
      "command": "pnpm dev:frontend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "Seed Database (200 Spaces & 5 Cities)",
      "type": "shell",
      "command": "pnpm prisma:seed",
      "problemMatcher": []
    },
    {
