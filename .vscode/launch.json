{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend API (Port 5000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "Debug Frontend in Chrome (Port 3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Chrome",
      "configurations": ["Debug Backend API (Port 5000)", "Debug Frontend in Chrome (Port 3000)"]
    }
  ]
}
