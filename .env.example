# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartspace?schema=public

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=smartspace_super_secret_jwt_access_token_key_2026!
JWT_REFRESH_SECRET=smartspace_super_secret_jwt_refresh_token_key_2026!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Email & Notifications (Mailhog / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@smartspace.io

# SMS Mock / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

